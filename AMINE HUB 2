local function createFeatureButton(name, parent, callback)
    local container = Instance.new("Frame", parent)
    container.Size = UDim2.new(0.95, 0, 0, 40)
    container.BackgroundTransparency = 1
    container.ZIndex = 2

    local btn = Instance.new("TextButton", container)
    btn.Size = UDim2.new(0.55, 0, 1, 0)
    btn.BackgroundColor3 = Color3.fromRGB(15, 20, 35)
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(220, 240, 255)
    btn.TextSize = 11
    btn.Font = Enum.Font.GothamBold
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.ZIndex = 2
    
    local btnStroke = Instance.new("UIStroke", btn)
    btnStroke.Color = Color3.fromRGB(0, 120, 220)
    btnStroke.Thickness = 1.5

    local padding = Instance.new("UIPadding", btn)
    padding.PaddingLeft = UDim.new(0, 10)
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local keyBox = Instance.new("TextBox", container)
    keyBox.Size = UDim2.new(0.16, 0, 1, 0)
    keyBox.Position = UDim2.new(0.57, 0, 0, 0)
    keyBox.BackgroundColor3 = Color3.fromRGB(20, 25, 45)
    keyBox.Text = ""
    keyBox.PlaceholderText = "Key"
    keyBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    keyBox.TextSize = 10
    keyBox.Font = Enum.Font.GothamBold
    keyBox.ClearTextOnFocus = false
    keyBox.ZIndex = 2
    Instance.new("UICorner", keyBox).CornerRadius = UDim.new(0, 6)
    
    local kbStroke = Instance.new("UIStroke", keyBox)
    kbStroke.Color = Color3.fromRGB(0, 100, 180)
    kbStroke.Thickness = 1

    local toggleBtn = Instance.new("TextButton", container)
    toggleBtn.Size = UDim2.new(0.24, 0, 1, 0)
    toggleBtn.Position = UDim2.new(0.76, 0, 0, 0)
    toggleBtn.BackgroundColor3 = Color3.fromRGB(25, 30, 50)
    toggleBtn.Text = "OFF"
    toggleBtn.TextColor3 = Color3.fromRGB(200, 220, 255)
    toggleBtn.TextSize = 11
    toggleBtn.Font = Enum.Font.GothamBold
    toggleBtn.ZIndex = 2
    Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 6)

    local tStroke = Instance.new("UIStroke", toggleBtn)
    tStroke.Color = Color3.fromRGB(0, 120, 220)
    tStroke.Thickness = 1

    local state = false
    local function trigger()
        state = not state
        toggleBtn.Text = state and "ON" or "OFF"
        toggleBtn.BackgroundColor3 = state and Color3.fromRGB(0, 150, 255) or Color3.fromRGB(25, 30, 50)
        tStroke.Color = state and Color3.fromRGB(0, 255, 255) or Color3.fromRGB(0, 120, 220)
        callback(state, btn)
    end

    toggleBtn.MouseButton1Click:Connect(trigger)
    btn.MouseButton1Click:Connect(trigger)

    keyBox.FocusLost:Connect(function()
        local txt = keyBox.Text:upper()
        if #txt > 0 then
            local keyCode = nil
            if txt == "1" then keyCode = Enum.KeyCode.One
            elseif txt == "2" then keyCode = Enum.KeyCode.Two
            elseif txt == "3" then keyCode = Enum.KeyCode.Three
            elseif txt == "4" then keyCode = Enum.KeyCode.Four
            elseif txt == "5" then keyCode = Enum.KeyCode.Five
            elseif txt == "6" then keyCode = Enum.KeyCode.Six
            elseif txt == "7" then keyCode = Enum.KeyCode.Seven
            elseif txt == "8" then keyCode = Enum.KeyCode.Eight
            elseif txt == "9" then keyCode = Enum.KeyCode.Nine
            elseif txt == "0" then keyCode = Enum.KeyCode.Zero
            else
                pcall(function()
                    keyCode = Enum.KeyCode[txt]
                end)
            end

            if keyCode then
                KeybindsList[keyCode] = trigger
            else
                keyBox.Text = ""
            end
        else
            for k, func in pairs(KeybindsList) do
                if func == trigger then
                    KeybindsList[k] = nil
                end
            end
        end
    end)

    return container, toggleBtn, btn
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.UserInputType == Enum.UserInputType.Keyboard then
        local boundFunc = KeybindsList[input.KeyCode]
        if boundFunc then
            boundFunc()
        end
    end
end)

