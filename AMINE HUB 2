        b.BackgroundColor3 = _G[stateKey] and Color3.fromRGB(0, 140, 255) or Color3.fromRGB(18, 24, 40)
        bStroke.Color = _G[stateKey] and Color3.fromRGB(0, 255, 255) or Color3.fromRGB(0, 120, 220)
        
        if stateKey == "DesyncHide" then
            local char = LP.Character
            if char then
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") or part:IsA("Decal") then
                        part.Transparency = _G[stateKey] and 1 or 0
                    end
                end
            end
        end
    end)
    return b
end

