RunService.RenderStepped:Connect(function()
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")

    if _G.BypassWalls and char then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end

    if _G.HideNameEnabled and char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        end
        local head = char:FindFirstChild("Head")
        if head then
            for _, v in pairs(head:GetChildren()) do
                if v:IsA("BillboardGui") then
                    v.Enabled = false
                end
            end
        end
    end

    if _G.DesyncEnabled and root then
        if _G.DesyncAuto then
            root.AssemblyLinearVelocity = Vector3.new(math.random(-500, 500), 0, math.random(-500, 500))
        end
        if _G.DesyncWall and char then
            for _, p in pairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end
    end

    if _G.EspEnabled then
        local activeEsp = {}
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChildOfClass("Humanoid") and p.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
                activeEsp[p] = true
                local pRoot = p.Character.HumanoidRootPart
                local box = EspContainer:FindFirstChild(p.Name .. "_EspBox")
                if not box then
                    box = Instance.new("BillboardGui", EspContainer)
                    box.Name = p.Name .. "_EspBox"
                    box.AlwaysOnTop = true
                    box.Size = UDim2.new(0, 50, 0, 70)
                    
                    local frame = Instance.new("Frame", box)
                    frame.Size = UDim2.new(1, 0, 1, 0)
                    frame.BackgroundTransparency = 0.8
                    frame.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
                    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 4)
                    local stroke = Instance.new("UIStroke", frame)
                    stroke.Color = Color3.fromRGB(0, 255, 255)
                    stroke.Thickness = 1.5

                    local nameTag = Instance.new("TextLabel", box)
                    nameTag.Name = "NameTag"
                    nameTag.Size = UDim2.new(0, 100, 0, 20)
                    nameTag.Position = UDim2.new(0.5, -50, 0, -22)
                    nameTag.BackgroundTransparency = 1
                    nameTag.TextColor3 = Color3.fromRGB(0, 220, 255)
                    nameTag.TextSize = 10
                    nameTag.Font = Enum.Font.GothamBold
                    nameTag.TextStrokeTransparency = 0
                end
                box.Adornee = pRoot
                local tag = box:FindFirstChild("NameTag")
                if tag then
                    local dist = root and math.floor((root.Position - pRoot.Position).Magnitude) or 0
                    tag.Text = p.DisplayName .. " [" .. dist .. "m]"
                end
            end
        end
        for _, obj in pairs(EspContainer:GetChildren()) do
            local found = false
            for p, _ in pairs(activeEsp) do
                if obj.Name == p.Name .. "_EspBox" then
                    found = true
                    break
                end
            end
            if not found then
                obj:Destroy()
            end
        end
    else
        EspContainer:ClearAllChildren()
    end

    if root then
        local adminNear = false
        local spectatorFound = false
        
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LP then
                local pNameLower = p.Name:lower()
                local displayNameLower = p.DisplayName:lower()
                local pChar = p.Character
                local pRoot = pChar and pChar:FindFirstChild("HumanoidRootPart")
                
                if pRoot then
                    local dist = (root.Position - pRoot.Position).Magnitude
                    if (pNameLower:find("admin") or pNameLower:find("mod") or pNameLower:find("staff") or displayNameLower:find("admin")) and dist < 35 then
                        adminNear = true
                    elseif dist < 20 then
                        spectatorFound = true
                    end
                end
            end
        end

        if adminNear then
            CenterAlert.Text = "⚠️ WARNING: AN ADMIN IS NEAR YOU! (يوجد مشرف قريب منك)"
            CenterAlert.BackgroundColor3 = Color3.fromRGB(40, 10, 10)
            CenterAlert.Visible = true
        elseif spectatorFound then
            CenterAlert.Text = "⚠️ WARNING: YOU ARE BEING WATCHED! (انت مراقب)"
            CenterAlert.BackgroundColor3 = Color3.fromRGB(40, 20, 10)
            CenterAlert.Visible = true
        else
            CenterAlert.Visible = false
        end

        if _G.AimbotEnabled then
            local closestTarget = nil
            local shortestDist = math.huge
            
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LP and not _G.GangMembers[p.UserId] then
                    local pChar = p.Character
                    local pHead = pChar and pChar:FindFirstChild("Head")
                    local pHumanoid = pChar and pChar:FindFirstChildOfClass("Humanoid")
                    
                    if pHead and pHumanoid and pHumanoid.Health > 0 then
                        local screenPoint, onScreen = Camera:WorldToViewportPoint(pHead.Position)
                        if onScreen then
                            local mousePos = UserInputService:GetMouseLocation()
                            local dist = (Vector2.new(screenPoint.X, screenPoint.Y) - mousePos).Magnitude
                            if dist < shortestDist then
                                shortestDist = dist
                                closestTarget = pHead
                            end
                        end
                    end
                end
            end
            
            if closestTarget then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestTarget.Position)
            end
        end

        if _G.FlyEnabled then
            local bv = root:FindFirstChild("AmineFlyForce")
            if not bv then
                bv = Instance.new("BodyVelocity")
                bv.Name = "AmineFlyForce"
                bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bv.Velocity = Vector3.new(0, 0, 0)
                bv.Parent = root
            end
            local speed = tonumber(flySpeedBox.Text) or 100
            local moveDir = Vector3.new(0, 0, 0)
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Camera.CFrame.RightVector end
            bv.Velocity = moveDir * speed
        else
            local bv = root:FindFirstChild("AmineFlyForce")
            if bv then bv:Destroy() end
        end
    end
end)
