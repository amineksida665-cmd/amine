local allPopups = {}

local function registerPopup(popup)
    table.insert(allPopups, popup)
    return popup
end

local function closeAllPopupsExcept(activePopup)
    for _, p in ipairs(allPopups) do
        if p ~= activePopup then
            p.Visible = false
        end
    end
end

