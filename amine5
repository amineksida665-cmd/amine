local function createPlayerListPopup(titleText, isTpAction)
    local popup = registerPopup(Instance.new("Frame", MainFrame))
    popup.Size = UDim2.new(0, 260, 0, 340)
    popup.Position = UDim2.new(-1, -10, 0, 0)
    popup.BackgroundColor3 = Color3.fromRGB(18, 18, 26)
    popup.Visible = false
    popup.ZIndex = 30
    Instance.new("UICorner", popup).CornerRadius = UDim.new(0, 8)
    local stroke = Instance.new("UIStroke", popup)
    stroke.Color = Color3.fromRGB(100, 150, 255)
    stroke.Thickness = 2

    local title = Instance.new("TextLabel", popup)
    title.Size = UDim2.new(1, -40, 0, 40)
    title.Position = UDim2.new(0, 15, 0, 5)
    title.Text = titleText
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.BackgroundTransparency = 1
    title.TextSize, title.Font = 12, Enum.Font.GothamBold
    title.ZIndex = 31
    title.TextXAlignment = Enum.TextXAlignment.Left

    local closeBtn = Instance.new("TextButton", popup)
    closeBtn.Size = UDim2.new(0, 28, 0, 28)
    closeBtn.Position = UDim2.new(1, -35, 0, 10)
    closeBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
    closeBtn.Text = "X"
    closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    closeBtn.TextSize, closeBtn.Font = 12, Enum.Font.GothamBold
    closeBtn.ZIndex = 31
    Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0, 6)

    closeBtn.MouseButton1Click:Connect(function()
        popup.Visible = false
    end)

    local scroll = Instance.new("ScrollingFrame", popup)
    scroll.Size = UDim2.new(0.9, 0, 0.75, 0)
    scroll.Position = UDim2.new(0.05, 0, 0.18, 0)
    scroll.BackgroundTransparency = 1
    scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    scroll.ScrollBarThickness = 3
    scroll.ZIndex = 31

    local listLayout = Instance.new("UIListLayout", scroll)
    listLayout.Padding = UDim.new(0, 5)
    listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center

    local function refreshList()
        for _, child in pairs(scroll:GetChildren()) do
            if child:IsA("TextButton") then
                child:Destroy()
            end
        end

        local count = 0
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LP then
                count = count + 1
                local pBtn = Instance.new("TextButton", scroll)
                pBtn.Size = UDim2.new(1, 0, 0, 35)
                pBtn.BackgroundColor3 = Color3.fromRGB(28, 28, 40)
                pBtn.Text = player.DisplayName .. " (" .. player.Name .. ")"
                pBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
                pBtn.TextSize, pBtn.Font = 10, Enum.Font.GothamBold
                pBtn.ZIndex = 32
                Instance.new("UICorner", pBtn).CornerRadius = UDim.new(0, 6)

                if not isTpAction and _G.GangMembers[player.UserId] then
                    pBtn.BackgroundColor3 = Color3.fromRGB(40, 100, 60)
                end

                pBtn.MouseButton1Click:Connect(function()
                    if isTpAction then
                        local targetChar = player.Character
                        local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
                        local myChar = LP.Character
                        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                        if targetRoot and myRoot then
                            myRoot.CFrame = targetRoot.CFrame + Vector3.new(0, 3, 0)
                        end
                    else
                        if _G.GangMembers[player.UserId] then
                            _G.GangMembers[player.UserId] = nil
                            pBtn.BackgroundColor3 = Color3.fromRGB(28, 28, 40)
                        else
                            _G.GangMembers[player.UserId] = true
                            pBtn.BackgroundColor3 = Color3.fromRGB(40, 100, 60)
                        end
                    end
                end)
            end
        end
        scroll.CanvasSize = UDim2.new(0, 0, 0, count * 40)
    end

    popup:GetPropertyChangedSignal("Visible"):Connect(function()
        if popup.Visible then
            refreshList()
        end
    end)

    return popup
end

