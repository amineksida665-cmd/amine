local function createToggleDesyncBtn(name, stateKey)
    _G[stateKey] = false
    local b = Instance.new("TextButton", DesyncScroll)
    b.Size = UDim2.new(0.9, 0, 0, 35)
    b.BackgroundColor3 = Color3.fromRGB(28, 28, 40)
    b.Text = name .. ": OFF"
    b.TextColor3 = Color3.fromRGB(220, 220, 220)
    b.TextSize, b.Font = 11, Enum.Font.GothamBold
    b.ZIndex = 27
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)

    b.MouseButton1Click:Connect(function()
        _G[stateKey] = not _G[stateKey]
        b.Text = name .. ": " .. (_G[stateKey] and "ON" or "OFF")
        b.BackgroundColor3 = _G[stateKey] and Color3.fromRGB(40, 100, 60) or Color3.fromRGB(28, 28, 40)
        
        if stateKey == "DesyncHide" then
            local char = LP.Character
            if char then
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") or part:IsA("Decal") then
                        part.Transparency = _G[stateKey] and 1 or 0
                    end
                end
            end
        end
    end)
    return b
end

