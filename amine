_G.IgnoredPlayers = {}

local function updateTargetList()
    for _, child in pairs(TargetScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP then
            local pBtn = Instance.new("TextButton", TargetScroll)
            pBtn.Size = UDim2.new(1, 0, 0, 35)
            pBtn.BackgroundColor3 = _G.IgnoredPlayers[p.Name] and Color3.fromRGB(150, 50, 50) or Color3.fromRGB(25, 25, 38)
            pBtn.Text = "PLAYER: " .. p.Name
            pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            pBtn.TextSize = 11
            pBtn.Font = Enum.Font.GothamBold
            pBtn.ZIndex = 11
            Instance.new("UICorner", pBtn).CornerRadius = UDim.new(0, 6)
            
            pBtn.MouseButton1Click:Connect(function()
                _G.IgnoredPlayers[p.Name] = not _G.IgnoredPlayers[p.Name]
                pBtn.BackgroundColor3 = _G.IgnoredPlayers[p.Name] and Color3.fromRGB(150, 50, 50) or Color3.fromRGB(25, 25, 38)
            end)
        end
    end
    TargetScroll.CanvasSize = UDim2.new(0, 0, 0, #Players:GetPlayers() * 40)
end

local function createDualFeature(name, callback)
    local Container = Instance.new("Frame", ScrollingFrame)
    Container.Size = UDim2.new(0.95, 0, 0, 42)
    Container.BackgroundTransparency = 1

    local LeftBtn = Instance.new("TextButton", Container)
    LeftBtn.Size = UDim2.new(0.58, 0, 1, 0)
    LeftBtn.Position = UDim2.new(0, 0, 0, 0)
    LeftBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 38)
    LeftBtn.Text = name .. ": OFF"
    LeftBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    LeftBtn.TextSize = 12
    LeftBtn.Font = Enum.Font.GothamBold
    Instance.new("UICorner", LeftBtn).CornerRadius = UDim.new(0, 6)

    local RightBtn = Instance.new("TextButton", Container)
    RightBtn.Size = UDim2.new(0.40, 0, 1, 0)
    RightBtn.Position = UDim2.new(0.60, 0, 0, 0)
    RightBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 38)
    RightBtn.Text = "[ Click to Bind ]"
    RightBtn.TextColor3 = Color3.fromRGB(150, 150, 180)
    RightBtn.TextSize = 10
    RightBtn.Font = Enum.Font.GothamMedium
    Instance.new("UICorner", RightBtn).CornerRadius = UDim.new(0, 6)

    local toggled = false
    LeftBtn.MouseButton1Click:Connect(function()
        toggled = not toggled
        LeftBtn.Text = name .. (toggled and ": ON" or ": OFF")
        LeftBtn.BackgroundColor3 = toggled and Color3.fromRGB(40, 100, 60) or Color3.fromRGB(25, 25, 38)
        callback(toggled)
    end)
end

local function createSingleFeature(name, callback)
    local MainBtn = Instance.new("TextButton", ScrollingFrame)
