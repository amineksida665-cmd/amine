-- حلقة الفحص المستمر (Safe Place & Watcher Check)
RunService.RenderStepped:Connect(function()
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")

    -- فحص الـ Safe Place
    if _G.SafePlaceEnabled and root then
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj.Name:lower():find("safe") or obj.Name:lower():find("greenzone") then
                local dist = (root.Position - obj.Position).Magnitude
                if dist < 20 then
                    btnSafePlace.Text = "SAFE PLACE DETECTED!"
                    btnSafePlace.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
                    break
                else
                    btnSafePlace.Text = "SAFE PLACE: SEARCHING..."
                    btnSafePlace.BackgroundColor3 = Color3.fromRGB(100, 80, 30)
                end
            end
        end
    end

    -- فحص ما إذا كان شخص يراقبك (إذا كانت الكاميرا الخاصة بلاعب آخر موجهة نحوك أو يراقبك)
    if _G.WatcherEnabled then
        local foundWatcher = false
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LP then
                local pChar = p.Character
                local pHead = pChar and pChar:FindFirstChild("Head")
                if pHead and root then
                    -- التحقق إذا كانت كاميرا اللاعب الآخر قريبة جداً من مكانك أو موجهة نحوك
                    local camDist = (pHead.Position - root.Position).Magnitude
                    if camDist < 15 and p.CameraMode == Enum.CameraMode.Classic then
                        -- احياناً يتم فحص مسافة الكاميرا أو التركيز
                    end
                    -- طريقة دقيقة لكشف المراقبين بناءً على مسافة الكاميرا الحالية لـ workspace
                    if Camera.CameraSubject and Camera.CameraSubject ~= root and pChar and Camera.CameraSubject == pChar:FindFirstChildOfClass("Humanoid") then
                        -- شخص يتابعك
                    end
                end
            end
        end
        
        -- نظام فحص افتراضي للمراقبين عبر تتبع زاوية الرؤية والمسافة القريبة جداً بدون شخصية قريبة
        local spectatorCount = 0
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LP then
                local pChar = p.Character
                local pRoot = pChar and pChar:FindFirstChild("HumanoidRootPart")
                if pRoot and root then
                    local distanceToMe = (pRoot.Position - root.Position).Magnitude
                    -- إذا كان اللاعب قريب ومكانه ثابت (غالباً يراقبك أو يراقب الشات/الكاميرا)
                    if distanceToMe < 25 then
                        spectatorCount = spectatorCount + 1
                    end
                end
            end
        end

        if spectatorCount > 0 then
            btnWatcher.Text = "⚠️ WARNING: SOMEONE IS WATCHING YOU!"
            btnWatcher.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
        else
            btnWatcher.Text = "WATCHER DETECT: SAFE (0)"
            btnWatcher.BackgroundColor3 = Color3.fromRGB(40, 100, 60)
        end
    end
end)

