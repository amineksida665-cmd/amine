-- زر HIDE YOUR NAME
local hideBtn = createDualFeature("HIDE YOUR NAME")
hideBtn.MouseButton1Click:Connect(function()
    local char = LP.Character
    local active = false
    if char then
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") then
                v.Transparency = (v.Transparency == 0) and 1 or 0
                active = (v.Transparency == 1)
            end
        end
    end
    hideBtn.Text = "HIDE YOUR NAME: " .. (active and "ON" or "OFF")
    hideBtn.BackgroundColor3 = active and Color3.fromRGB(40, 100, 60) or Color3.fromRGB(25, 25, 38)
end)

