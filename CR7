    btn.TextColor3 = Color3.fromRGB(255, 230, 235)
    btn.TextSize, btn.Font = 10, Enum.Font.GothamBold
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.ZIndex = 2
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    local btnStroke = Instance.new("UIStroke", btn)
    btnStroke.Color = Color3.fromRGB(200, 30, 60)
    btnStroke.Thickness = 1.2

    local icon = Instance.new("ImageLabel", btn)
    icon.Size = UDim2.new(0, 18, 0, 18)
    icon.Position = UDim2.new(0, 4, 0.5, -9)
    icon.BackgroundTransparency = 1
    icon.Image = WeaponGuyIconId
    icon.ImageColor3 = Color3.fromRGB(255, 80, 100)
    icon.ZIndex = 3

    local keyBox = Instance.new("TextBox", container)
    keyBox.Size = UDim2.new(0.12, 0, 1, 0)
    keyBox.Position = UDim2.new(0.56, 0, 0, 0)
    keyBox.BackgroundColor3 = Color3.fromRGB(45, 20, 35)
    keyBox.Text = defaultKey or ""
    keyBox.TextColor3 = Color3.fromRGB(255, 120, 140)
    keyBox.TextSize, keyBox.Font = 10, Enum.Font.GothamBold
    keyBox.ZIndex = 2
    Instance.new("UICorner", keyBox).CornerRadius = UDim.new(0, 6)
    local kStroke = Instance.new("UIStroke", keyBox)
    kStroke.Color = Color3.fromRGB(200, 30, 60)

    local toggleBtn = Instance.new("TextButton", container)
    toggleBtn.Size = UDim2.new(0.30, 0, 1, 0)
    toggleBtn.Position = UDim2.new(0.70, 0, 0, 0)
    toggleBtn.BackgroundColor3 = Color3.fromRGB(35, 15, 25)
    toggleBtn.Text = "OFF"
    toggleBtn.TextColor3 = Color3.fromRGB(255, 120, 120)
    toggleBtn.TextSize, toggleBtn.Font = 11, Enum.Font.GothamBold
    toggleBtn.ZIndex = 2
    Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 6)
    local tStroke = Instance.new("UIStroke", toggleBtn)
    tStroke.Color = Color3.fromRGB(200, 30, 60)
    tStroke.Thickness = 1.2

    local state = false
    local function trigger()
        state = not state
        toggleBtn.Text = state and "ON" or "OFF"
        toggleBtn.TextColor3 = state and Color3.fromRGB(100, 255, 100) or Color3.fromRGB(255, 120, 120)
        toggleBtn.BackgroundColor3 = state and Color3.fromRGB(20, 50, 30) or Color3.fromRGB(35, 15, 25)
        tStroke.Color = state and Color3.fromRGB(0, 220, 120) or Color3.fromRGB(200, 30, 60)
        callback(state)
    end

    toggleBtn.MouseButton1Click:Connect(trigger)
    btn.MouseButton1Click:Connect(trigger)

    local assignedKey = Enum.KeyCode[defaultKey:upper()]
    keyBox.FocusLost:Connect(function()
        local txt = keyBox.Text:upper()
        if #txt > 0 then
            local success, keyCode = pcall(function() return Enum.KeyCode[txt] end)
            if success and keyCode then
                assignedKey = keyCode
                keyBox.Text = txt
            else
                keyBox.Text = defaultKey
            end
        end
    end)

    table.insert(registeredToggles, {
        getKey = function() return assignedKey end,
        fire = trigger
    })

    return container
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.UserInputType == Enum.UserInputType.Keyboard then
        for _, item in ipairs(registeredToggles) do
            if input.KeyCode == item.getKey() then
                item.fire()
            end
        end
    end
end)

