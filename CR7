                        local infoLabel = Instance.new("TextLabel", exploitBox)
                        infoLabel.Name = "InfoLabel"
                        infoLabel.Size = UDim2.new(1, 0, 1, 0)
                        infoLabel.BackgroundTransparency = 1
                        infoLabel.TextSize = 11
                        infoLabel.Font = Enum.Font.GothamBold
                        infoLabel.TextStrokeTransparency = 0.3
                    end

                    local infoLabel = exploitBox:FindFirstChild("InfoLabel")
                    if infoLabel then
                        infoLabel.Text = "🚨 " .. p.DisplayName .. "\n[" .. exploitType .. "]"
                        infoLabel.TextColor3 = Color3.fromRGB(255, 180, 50)
                    end
                    exploitBox.Adornee = pRoot

                    if _G.SecretaryActive then
                        SecMsg.Text = "⚠️ رصد هكر نشط وتم تسجيله بالقائمة:\nاللاعب (" .. p.DisplayName .. ")\nالحالة: " .. exploitType
                    end
                else
                    local hl = pChar:FindFirstChild("AmineExploitHL")
                    if hl then hl:Destroy() end
