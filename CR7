                        infoLabel.BackgroundTransparency = 1
                        infoLabel.TextSize = 12
                        infoLabel.Font = Enum.Font.GothamBold
                        infoLabel.TextStrokeTransparency = 0.3
                    end

                    local infoLabel = adminBox:FindFirstChild("InfoLabel")
                    if infoLabel and hum then
                        infoLabel.Text = "👑 ADMIN: " .. p.DisplayName .. "\nHP: " .. math.floor(hum.Health)
                        infoLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
                    end
                    adminBox.Adornee = pRoot
                end
            end
        end

        if _G.SecretaryActive and not string.find(SecMsg.Text, "رصد هكر نشط") then
            SecMsg.Text = secretaryReportText
        end

        if adminNear then
            local intensity = math.clamp(1 - (closestDist / 1000), 0.1, 1)
            local flash = math.floor(tick() * (5 + (intensity * 15))) % 2 == 0
            
            CenterAlert.Text = "⚠️ ADMIN (" .. adminFoundName .. ") - " .. math.floor(closestDist) .. "M NEAR!"
            CenterAlert.Visible = true
            CenterAlert.BackgroundColor3 = flash and Color3.fromRGB(90, 15, 20) or Color3.fromRGB(180, 20, 40)
            AlertStroke.Color = flash and Color3.fromRGB(255, 50, 70) or Color3.fromRGB(255, 255, 100)
        else
            CenterAlert.Visible = false
        end
    else
        AdminEspContainer:ClearAllChildren()
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character then
                local hl = p.Character:FindFirstChild("AmineAdminBodyHL")
                if hl then hl:Destroy() end
            end
        end
        CenterAlert.Visible = false
        if _G.SecretaryActive and not _G.DetectFlyInvisActive then
            SecMsg.Text = "السكرتيرة في وضع الاستعداد..."
        end
    end

    if _G.AimbotEnabled and root then
        local closestTarget = nil
        local shortestDist = math.huge
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then
                if not GangList[p.UserId] then
                    local pHead = p.Character:FindFirstChild("Head")
                    local pRootPart = p.Character:FindFirstChild("HumanoidRootPart")
                    local pHumanoid = p.Character:FindFirstChildOfClass("Humanoid")
                    if pHead and pRootPart and pHumanoid and pHumanoid.Health > 0 then
                        local distanceToPlayer = (root.Position - pRootPart.Position).Magnitude
                        if distanceToPlayer <= 500 then
                            local directionToPlayer = (pRootPart.Position - root.Position).Unit
                            local lookVector = Camera.CFrame.LookVector
                            local dotProduct = lookVector:Dot(directionToPlayer)
                            
                            if dotProduct > 0.1 then
                                local screenPoint, onScreen = Camera:WorldToViewportPoint(pHead.Position)
                                if onScreen then
                                    local raycastParams = RaycastParams.new()
                                    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
                                    raycastParams.FilterDescendantsInstances = {char, p.Character}
                                    raycastParams.IgnoreWater = true
                                    
                                    local rayResult = workspace:Raycast(Camera.CFrame.Position, pHead.Position - Camera.CFrame.Position, raycastParams)
                                    if not rayResult then
                                        local dist = (Vector2.new(screenPoint.X, screenPoint.Y) - UserInputService:GetMouseLocation()).Magnitude
                                        local currentMaxDist = _G.FovRadius or 150
                                        if dist < shortestDist and dist <= currentMaxDist then
                                            shortestDist = dist
                                            closestTarget = pHead
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        if closestTarget then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestTarget.Position)
        end
    end
end)
