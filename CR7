                            adminNear = true
                            adminFoundName = p.DisplayName .. " (" .. p.Name .. ")"
                            if dist < closestDist then
                                closestDist = dist
                                secretaryReportText = "⚠️ تحذير سكرتيرة أمين:\nتم رصد المشرف (" .. p.DisplayName .. ")\nالمسافة تقريبياً: " .. math.floor(dist) .. " متر!"
                            end
                        end
                    end

                    local hl = pChar:FindFirstChild("AmineAdminBodyHL")
                    if not hl then
