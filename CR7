local function createSliderOption(labelText, minVal, maxVal, defaultVal, callback)
    local container = Instance.new("Frame", ScrollingFrame)
    container.Size = UDim2.new(0.96, 0, 0, 50)
    container.BackgroundTransparency = 1
    container.ZIndex = 2

    local lbl = Instance.new("TextLabel", container)
    lbl.Size = UDim2.new(1, 0, 0, 20)
    lbl.Position = UDim2.new(0, 0, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = "  " .. labelText .. ": " .. tostring(defaultVal)
    lbl.TextColor3 = Color3.fromRGB(255, 230, 235)
    lbl.TextSize, lbl.Font = 10, Enum.Font.GothamBold
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 2

    local sliderBg = Instance.new("Frame", container)
    sliderBg.Size = UDim2.new(1, 0, 0, 16)
    sliderBg.Position = UDim2.new(0, 0, 0, 26)
    sliderBg.BackgroundColor3 = Color3.fromRGB(30, 15, 25)
    sliderBg.ZIndex = 2
    Instance.new("UICorner", sliderBg).CornerRadius = UDim.new(0, 8)
    local bgStroke = Instance.new("UIStroke", sliderBg)
    bgStroke.Color = Color3.fromRGB(200, 30, 60)
    bgStroke.Thickness = 1.2

    local sliderFill = Instance.new("Frame", sliderBg)
    local initPercent = math.clamp((defaultVal - minVal) / (maxVal - minVal), 0, 1)
    sliderFill.Size = UDim2.new(initPercent, 0, 1, 0)
    sliderFill.BackgroundColor3 = Color3.fromRGB(255, 40, 80)
    sliderFill.ZIndex = 3
    Instance.new("UICorner", sliderFill).CornerRadius = UDim.new(0, 8)

    local dragging = false
    local function updateValue(input)
        local posx = math.clamp((input.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
        sliderFill.Size = UDim2.new(posx, 0, 1, 0)
        local val = math.floor(minVal + ((maxVal - minVal) * posx))
        lbl.Text = "  " .. labelText .. ": " .. tostring(val)
        callback(val)
    end

    sliderBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateValue(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateValue(input)
        end
    end)

    return container
end

