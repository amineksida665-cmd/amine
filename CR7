RunService.RenderStepped:Connect(function()
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")

    if _G.FovCircleEnabled then
        local mousePos = UserInputService:GetMouseLocation()
        FovCircle.Position = mousePos
        FovCircle.Radius = _G.FovRadius or 150
        FovCircle.Visible = (_G.FovRadius and _G.FovRadius > 0)
    else
        FovCircle.Visible = false
    end

    if _G.HighJumpEnabled and humanoid then
        humanoid.JumpPower = 120
    elseif humanoid then
        humanoid.JumpPower = 50
    end

    if _G.HideNameEnabled and char then
        if humanoid then humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end
        for _, obj in pairs(char:GetDescendants()) do
            if obj:IsA("BillboardGui") and obj.Name ~= "AmineCustomNameTag" then
                obj.Enabled = false
            elseif obj:IsA("SurfaceGui") then
                obj.Enabled = false
            end
        end
    end

    local function checkIsAdmin(p)
        local usernameLower = p.Name:lower()
        if NotAdminsList[usernameLower] then return false end

        local displayLower = p.DisplayName:lower()
        if CustomAdmins[usernameLower] or CustomAdmins[displayLower] then return true end
        if string.find(usernameLower, "admin") or string.find(displayLower, "admin") or 
           string.find(usernameLower, "mod") or string.find(displayLower, "mod") or
           string.find(usernameLower, "owner") or string.find(displayLower, "owner") or
           string.find(usernameLower, "staff") or string.find(displayLower, "staff") or
           string.find(usernameLower, "helper") or string.find(displayLower, "helper") then
            return true
        end
        local pChar = p.Character
        if pChar then
            for _, item in pairs(pChar:GetChildren()) do
                if item:IsA("Tool") and (string.find(item.Name:lower(), "admin") or string.find(item.Name:lower(), "ban") or string.find(item.Name:lower(), "mod") or string.find(item.Name:lower(), "hammer")) then
                    return true
                end
            end
        end
        return false
    end

    local function checkFlyingOrInvisible(p)
        local usernameLower = p.Name:lower()
        if NotAdminsList[usernameLower] then return false, "" end

        local pChar = p.Character
        if not pChar then return false, "" end
        
        local pRoot = pChar:FindFirstChild("HumanoidRootPart")
        local pHumanoid = pChar:FindFirstChildOfClass("Humanoid")
        if not pRoot or not pHumanoid then return false, "" end
        
        local raycastParams = RaycastParams.new()
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude
        raycastParams.FilterDescendantsInstances = {pChar}
        raycastParams.IgnoreWater = true
        
        local rayResult = workspace:Raycast(pRoot.Position, Vector3.new(0, -15, 0), raycastParams)
        local isFlying = (not rayResult and pRoot.Position.Y > 5 and pHumanoid.FloorMaterial == Enum.Material.Air and math.abs(pRoot.AssemblyLinearVelocity.Y) < 2)
        
        local isInvisible = false
        local transparentPartsCount = 0
        local totalPartsCount = 0
        
        for _, part in pairs(pChar:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                totalPartsCount = totalPartsCount + 1
                if part.Transparency > 0.5 or not part.CanCollide then
                    transparentPartsCount = transparentPartsCount + 1
                end
            end
        end
        
        if totalPartsCount > 0 and (transparentPartsCount / totalPartsCount) > 0.6 then
            isInvisible = true
        end
        
        if isFlying and isInvisible then
            return true, "طيران + اختفاء"
        elseif isFlying then
            return true, "طيران (Fly)"
        elseif isInvisible then
            return true, "اختفاء (Invis)"
        end
        
        return false, ""
    end

    if _G.EspEnabled then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local pChar = p.Character
                local pRoot = pChar.HumanoidRootPart
                local hum = pChar:FindFirstChildOfClass("Humanoid")
                
                if not checkIsAdmin(p) then
                    local redColor = Color3.fromRGB(240, 40, 80)
                    local hl = pChar:FindFirstChild("AminePlayerBodyHL")
                    if not hl then
                        hl = Instance.new("Highlight")
                        hl.Name = "AminePlayerBodyHL"
                        hl.Adornee = pChar
                        hl.FillTransparency = 0.5
                        hl.OutlineTransparency = 0
                        hl.Parent = pChar
                    end
                    hl.FillColor = redColor
                    hl.OutlineColor = redColor

                    local playerBox = EspContainer:FindFirstChild(p.Name .. "_PlayerBody")
                    if not playerBox then
                        playerBox = Instance.new("BillboardGui", EspContainer)
                        playerBox.Name = p.Name .. "_PlayerBody"
                        playerBox.AlwaysOnTop = true
                        playerBox.Size = UDim2.new(0, 120, 0, 45)
                        playerBox.StudsOffset = Vector3.new(0, 3, 0)

                        local infoLabel = Instance.new("TextLabel", playerBox)
                        infoLabel.Name = "InfoLabel"
                        infoLabel.Size = UDim2.new(1, 0, 1, 0)
                        infoLabel.BackgroundTransparency = 1
                        infoLabel.TextSize = 12
                        infoLabel.Font = Enum.Font.GothamBold
                        infoLabel.TextStrokeTransparency = 0.3
                    end

                    local infoLabel = playerBox:FindFirstChild("InfoLabel")
                    if infoLabel and hum then
                        infoLabel.Text = p.DisplayName .. "\nHP: " .. math.floor(hum.Health)
                        infoLabel.TextColor3 = redColor
                    end
                    playerBox.Adornee = pRoot
                end
            end
        end
    else
        EspContainer:ClearAllChildren()
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character then
                local hl = p.Character:FindFirstChild("AminePlayerBodyHL")
                if hl then hl:Destroy() end
            end
        end
    end

    if _G.DetectFlyInvisActive then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local pChar = p.Character
                local pRoot = pChar.HumanoidRootPart
                local isExploiting, exploitType = checkFlyingOrInvisible(p)

                if isExploiting then
                    local alreadyExists = false
                    for _, existing in pairs(DetectedHackersList) do
                        if existing.name == p.Name then
                            alreadyExists = true
                            break
                        end
                    end
                    if not alreadyExists then
                        table.insert(DetectedHackersList, {name = p.Name, displayName = p.DisplayName})
                    end

                    local hl = pChar:FindFirstChild("AmineExploitHL")
                    if not hl then
                        hl = Instance.new("Highlight")
                        hl.Name = "AmineExploitHL"
                        hl.Adornee = pChar
                        hl.FillTransparency = 0.3
                        hl.OutlineTransparency = 0
                        hl.Parent = pChar
                    end
                    hl.FillColor = Color3.fromRGB(255, 160, 20)
                    hl.OutlineColor = Color3.fromRGB(255, 255, 50)

                    local exploitBox = ExploitEspContainer:FindFirstChild(p.Name .. "_ExploitBody")
                    if not exploitBox then
                        exploitBox = Instance.new("BillboardGui", ExploitEspContainer)
                        exploitBox.Name = p.Name .. "_ExploitBody"
                        exploitBox.AlwaysOnTop = true
                        exploitBox.Size = UDim2.new(0, 160, 0, 45)
