-- نظام الأيمبوت الذكي (يتخطى أعضاء العصابة المسجلين تلقائياً)
RunService.RenderStepped:Connect(function()
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")

    if root then
        -- فحص المشرفين والمراقبة
        local adminNear = false
        local spectatorFound = false
        
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LP then
                local pNameLower = p.Name:lower()
                local displayNameLower = p.DisplayName:lower()
                local pChar = p.Character
                local pRoot = pChar and pChar:FindFirstChild("HumanoidRootPart")
                
                if pRoot then
                    local dist = (root.Position - pRoot.Position).Magnitude
                    if (pNameLower:find("admin") or pNameLower:find("mod") or pNameLower:find("staff") or displayNameLower:find("admin")) and dist < 35 then
                        adminNear = true
                    elseif dist < 20 then
                        spectatorFound = true
                    end
                end
            end
        end

        if adminNear then
            CenterAlert.Text = "⚠️ WARNING: AN ADMIN IS NEAR YOU! (يوجد مشرف قريب منك)"
            CenterAlert.BackgroundColor3 = Color3.fromRGB(220, 30, 30)
            CenterAlert.Visible = true
        elseif spectatorFound then
            CenterAlert.Text = "⚠️ WARNING: YOU ARE BEING WATCHED! (انت مراقب)"
            CenterAlert.BackgroundColor3 = Color3.fromRGB(200, 100, 20)
            CenterAlert.Visible = true
        else
            CenterAlert.Visible = false
        end

        -- تشغيل الأيمبوت مع استثناء أعضاء العصابة
        if _G.AimbotEnabled then
            local closestTarget = nil
            local shortestDist = math.huge
            
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LP and not _G.GangMembers[p.UserId] then
                    local pChar = p.Character
                    local pHead = pChar and pChar:FindFirstChild("Head")
                    local pHumanoid = pChar and pChar:FindFirstChildOfClass("Humanoid")
                    
                    if pHead and pHumanoid and pHumanoid.Health > 0 then
                        local screenPoint, onScreen = Camera:WorldToViewportPoint(pHead.Position)
                        if onScreen then
                            local mousePos = UserInputService:GetMouseLocation()
                            local dist = (Vector2.new(screenPoint.X, screenPoint.Y) - mousePos).Magnitude
                            if dist < shortestDist then
                                shortestDist = dist
                                closestTarget = pHead
                            end
                        end
                    end
                end
            end
            
            if closestTarget then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestTarget.Position)
            end
        end
    end
end)
